{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v3.0.0-alpha.1/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Norrix",
  "identifier": "com.mayocream.norrix",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../packages/norrix/out",
    "beforeDevCommand": "bun scripts/generate-icons.mjs && bun run --filter @norrix/bridge build && bun run --parallel --filter @norrix/bridge --filter @norrix/app dev",
    "beforeBuildCommand": "bun scripts/generate-icons.mjs && bun run --filter @norrix/bridge build && bun run --filter @norrix/app build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "title": "Norrix",
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "license": "MIT OR Apache-2.0",
    "resources": ["../../LICENSE-MIT", "../../LICENSE-APACHE"]
  }
}
